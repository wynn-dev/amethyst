{
  "name": "@amethyst/desktop",
  "productName": "Amethyst",
  "version": "0.0.0",
  "private": true,
  "description": "A fast, native-feeling Minecraft launcher for macOS",
  "license": "GPL-3.0-only",
  "author": "wynn-dev",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "node scripts/dist.mjs",
    "icon": "sh scripts/make-icon.sh",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "size": "node scripts/bundle-size.mjs",
    "e2e:launch": "tsx --tsconfig tsconfig.node.json scripts/e2e-launch.ts",
    "bench": "tsx --tsconfig tsconfig.node.json scripts/bench/run.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@amethyst/auth": "workspace:*",
    "@amethyst/content": "workspace:*",
    "@amethyst/game": "workspace:*",
    "@amethyst/installer": "workspace:*",
    "@amethyst/java": "workspace:*",
    "@amethyst/marketplace": "workspace:*",
    "@amethyst/modpack": "workspace:*",
    "@amethyst/nbt": "workspace:*",
    "@amethyst/net": "workspace:*",
    "@amethyst/task": "workspace:*",
    "@amethyst/telemetry": "workspace:*",
    "@amethyst/zip": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-virtual": "^3.14.22",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dompurify": "^3.4.17",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "happy-dom": "^21.0.4",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "skinview3d": "3.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  }
}
