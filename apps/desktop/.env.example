# Copy to .env.local for local builds. CI reads the same names from GitHub Actions secrets.
# All of these are embedded in the app binary, so treat them as "public but unadvertised".

# Azure app registration (Application/client ID) approved for the Minecraft API.
AMETHYST_MSA_CLIENT_ID=

# CurseForge Core API key from console.curseforge.com.
AMETHYST_CURSEFORGE_API_KEY=

# PostHog project API key (phc_…). Host defaults to the EU cloud.
AMETHYST_POSTHOG_KEY=
AMETHYST_POSTHOG_HOST=https://eu.i.posthog.com
