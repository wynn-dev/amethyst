{
 "arguments": {
  "game": [
   "--username",
   "${auth_player_name}",
   "--version",
   "${version_name}",
   "--gameDir",
   "${game_directory}",
   "--assetsDir",
   "${assets_root}",
   "--assetIndex",
   "${assets_index_name}",
   "--uuid",
   "${auth_uuid}",
   "--accessToken",
   "${auth_access_token}",
   "--clientId",
   "${clientid}",
   "--xuid",
   "${auth_xuid}",
   "--userType",
   "${user_type}",
   "--versionType",
   "${version_type}",
   {
    "rules": [
     {
      "action": "allow",
      "features": {
       "is_demo_user": true
      }
     }
    ],
    "value": "--demo"
   },
   {
    "rules": [
     {
      "action": "allow",
      "features": {
       "has_custom_resolution": true
      }
     }
    ],
    "value": [
     "--width",
     "${resolution_width}",
     "--height",
     "${resolution_height}"
    ]
   },
   {
    "rules": [
     {
      "action": "allow",
